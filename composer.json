{
    "name": "ekkles/church-management",
    "description": "Sistema integral de gestión para iglesias cristianas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^5.5",
        "ramsey/uuid": "^4.7",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^1.28",
        "endroid/qr-code": "^4.8",
        "spomky-labs/otphp": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env')) { copy('.env.example', '.env'); echo '.env creado desde .env.example'; }\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
