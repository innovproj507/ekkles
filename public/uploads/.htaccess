# Bloquear acceso a archivos potencialmente ejecutables
<FilesMatch "\.(?i:php|php[0-9]|phtml|cgi|pl|py|jsp|asp|sh|exe|bat|cmd)$">
    Require all denied
</FilesMatch>

# Deshabilitar el motor PHP en este directorio (si mod_php está habilitado)
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Prevenir listado de directorios
Options -Indexes
