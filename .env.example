# ══════════════════════════════════════════════
# Ekkles — Variables de Entorno
# Copie este archivo a .env y configure los valores
# ══════════════════════════════════════════════

# ── Aplicación ──────────────────────────────────
APP_NAME="Ekkles"
APP_ENV=local
APP_URL=http://ekkles.local
APP_TIMEZONE=America/Panama
APP_VERSION=1.0.0
APP_DEBUG=true
DEFAULT_CHURCH_ID=1

# ── Base de Datos ────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ekkles
DB_USER=root
DB_PASS=

# ── Sesión ───────────────────────────────────────
SESSION_NAME=ekkles_sess
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# ── Seguridad ────────────────────────────────────
CSRF_SECRET=cambia_este_secreto_random_32_chars_min
ENCRYPTION_KEY=cambia_esta_clave_de_cifrado_256bits

# ── Uploads ──────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=public/uploads

# ── Email (para futuras notificaciones) ──────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@ekkles.local
MAIL_PASS=
MAIL_FROM_NAME="Ekkles"
MAIL_ENCRYPTION=tls
